{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "selectedQuestions", "deferredQuestions", "unresolved"],
  "$defs": {
    "viewRef": {
      "type": "object", "additionalProperties": false,
      "required": ["viewId", "ref"],
      "properties": {
        "viewId": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schemaVersion": {"const": "ontology-prioritize-v2"},
    "selectedQuestions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pageOffset", "questionId", "specificQuestion", "selectionReason", "currentUnknowns", "candidateEntryRefs", "initialReadRequests", "taskKinds"],
        "properties": {
          "pageOffset": {"type": "integer", "minimum": 0},
          "questionId": {"type": "string", "pattern": "^Q[0-9]+$"},
          "specificQuestion": {"type": "string", "minLength": 1},
          "selectionReason": {"type": "string", "minLength": 1},
          "currentUnknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "candidateEntryRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/viewRef"}},
          "initialReadRequests": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["unitRef", "purpose"],
              "properties": {
                "unitRef": {"$ref": "#/$defs/viewRef"},
                "purpose": {"type": "string", "minLength": 1}
              }
            }
          },
          "taskKinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["OBJECT", "ACTION", "ANALYTIC", "RELATE"]}}
        }
      }
    },
    "deferredQuestions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pageOffset", "questionId", "reason"],
        "properties": {
          "pageOffset": {"type": "integer", "minimum": 0},
          "questionId": {"type": "string", "pattern": "^Q[0-9]+$"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "unresolved": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
