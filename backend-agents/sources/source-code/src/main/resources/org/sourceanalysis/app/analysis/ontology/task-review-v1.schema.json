{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskKind", "finalDefinitions", "corrections", "unresolvedQuestions"],
  "properties": {
    "schemaVersion": {"const": "ontology-task-review-v1"},
    "taskKind": {"enum": ["OBJECT", "ACTION", "ANALYTIC", "RELATE"]},
    "finalDefinitions": {"type": "array", "items": {"$ref": "#/$defs/definition"}},
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetLocalId", "reason"],
        "properties": {
          "targetLocalId": {"type": "string", "pattern": "^[A-Z][0-9]+$"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "unresolvedQuestions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localId", "kind", "name", "origin", "certainty", "claims", "unknowns"],
      "properties": {
        "localId": {"type": "string", "pattern": "^[A-Z][0-9]+$"},
        "kind": {"enum": ["OBJECT", "ACTION", "ANALYTIC", "RELATE"]},
        "name": {"type": "string", "minLength": 1},
        "origin": {"enum": ["IMPLEMENTATION", "ANALYTIC_EXTENSION"]},
        "certainty": {"enum": ["CONFIRMED", "INFERRED", "UNRESOLVED"]},
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "text", "evidenceRefs"],
            "properties": {
              "role": {"enum": ["IDENTITY", "ATTRIBUTE", "VARIANT", "PRECONDITION", "REJECTION", "EFFECT", "OUTPUT", "LINK_MECHANISM", "GRAIN", "EXPRESSION", "FILTER", "DIMENSION", "MEASURE", "METRIC"]},
              "text": {"type": "string", "minLength": 1},
              "evidenceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}}
            }
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "reason"],
            "properties": {
              "field": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
