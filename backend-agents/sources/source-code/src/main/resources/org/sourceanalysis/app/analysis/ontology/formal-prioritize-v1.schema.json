{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "selectedQuestions", "deferredQuestions", "unresolved"],
  "$defs": {
    "selected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionRef", "specificQuestion", "selectionReason", "currentUnknowns", "taskKinds"],
      "properties": {
        "questionRef": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
        "specificQuestion": {"type": "string", "minLength": 1},
        "selectionReason": {"type": "string", "minLength": 1},
        "currentUnknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "taskKinds": {"type": "array", "uniqueItems": true, "items": {"enum": ["OBJECT", "ACTION", "ANALYTIC"]}}
      }
    },
    "deferred": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionRef", "reason"],
      "properties": {
        "questionRef": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schemaVersion": {"const": "ontology-prioritize-response-v4"},
    "selectedQuestions": {"type": "array", "items": {"$ref": "#/$defs/selected"}},
    "deferredQuestions": {"type": "array", "items": {"$ref": "#/$defs/deferred"}},
    "unresolved": {"type": "array", "items": {"type": "object"}}
  }
}
