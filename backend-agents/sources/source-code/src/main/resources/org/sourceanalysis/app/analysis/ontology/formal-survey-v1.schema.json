{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "systemHypotheses", "questions", "unresolved"],
  "$defs": {
    "shortRef": {"type": "string", "pattern": "^[EK][1-9][0-9]*$"},
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "observedEntryRefs", "uncertainty"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "observedEntryRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^E[1-9][0-9]*$"}},
        "uncertainty": {"type": "string", "minLength": 1}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "question", "candidateEntryRefs", "clueRefs", "searchTerms"],
      "properties": {
        "questionId": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
        "question": {"type": "string", "minLength": 1},
        "candidateEntryRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^E[1-9][0-9]*$"}},
        "clueRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^K[1-9][0-9]*$"}},
        "searchTerms": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "properties": {
    "schemaVersion": {"const": "ontology-survey-response-v3"},
    "systemHypotheses": {"type": "array", "items": {"$ref": "#/$defs/hypothesis"}},
    "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}},
    "unresolved": {"type": "array", "items": {"type": "object"}}
  }
}
