{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskKind", "objects", "links", "operations", "dimensions", "measures", "metrics", "corrections", "unresolvedQuestions"],
  "properties": {
    "schemaVersion": {"type": "string", "enum": ["ontology-typed-candidate-v1", "ontology-typed-review-v1"]},
    "taskKind": {"type": "string", "enum": ["OBJECT", "ACTION", "ANALYTIC", "RELATE"]},
    "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}},
    "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
    "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
    "dimensions": {"type": "array", "items": {"$ref": "#/$defs/dimension"}},
    "measures": {"type": "array", "items": {"$ref": "#/$defs/measure"}},
    "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
    "corrections": {"type": "array", "items": {"$ref": "#/$defs/correction"}},
    "unresolvedQuestions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "unknown": {"type": "object", "additionalProperties": false, "required": ["field", "reason"], "properties": {"field": {"type": "string"}, "reason": {"type": "string"}}},
    "correction": {"type": "object", "additionalProperties": false, "required": ["targetLocalId", "reason"], "properties": {"targetLocalId": {"type": "string"}, "reason": {"type": "string"}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["bindings", "scope", "uniquenessBasis", "evidenceRefs"], "properties": {"bindings": {"type": "array", "items": {"type": "string"}}, "scope": {"type": "string"}, "uniquenessBasis": {"type": "string", "enum": ["DECLARED", "CODE_EXPECTED", "UNKNOWN"]}, "evidenceRefs": {"type": "array", "items": {"type": "string"}}}},
    "property": {"type": "object", "additionalProperties": false, "required": ["name", "sourceBinding", "meaning", "evidenceRefs"], "properties": {"name": {"type": "string"}, "sourceBinding": {"type": "string"}, "meaning": {"type": "string"}, "evidenceRefs": {"type": "array", "items": {"type": "string"}}}},
    "variant": {"type": "object", "additionalProperties": false, "required": ["name", "predicate", "evidenceRefs"], "properties": {"name": {"type": "string"}, "predicate": {"type": "string"}, "evidenceRefs": {"type": "array", "items": {"type": "string"}}}},
    "mechanism": {"type": "object", "additionalProperties": false, "required": ["fromBinding", "toBinding", "transfer", "condition", "evidenceRefs"], "properties": {"fromBinding": {"type": "string"}, "toBinding": {"type": "string"}, "transfer": {"type": "string"}, "condition": {"type": "string"}, "evidenceRefs": {"type": "array", "items": {"type": "string"}}}},
    "effect": {"type": "object", "additionalProperties": false, "required": ["condition", "description", "targetObjectRef", "targetField", "evidenceRefs"], "properties": {"condition": {"type": "string"}, "description": {"type": "string"}, "targetObjectRef": {"type": "string"}, "targetField": {"type": "string"}, "evidenceRefs": {"type": "array", "items": {"type": "string"}}}},
    "object": {"type": "object", "additionalProperties": false, "required": ["localId", "name", "description", "origin", "certainty", "evidenceRefs", "unknowns", "identity", "properties", "variants"], "properties": {"localId": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "origin": {"type": "string", "enum": ["IMPLEMENTATION", "ANALYTIC_EXTENSION"]}, "certainty": {"type": "string", "enum": ["CONFIRMED", "INFERRED", "UNRESOLVED"]}, "evidenceRefs": {"type": "array", "items": {"type": "string"}}, "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}}, "identity": {"$ref": "#/$defs/identity"}, "properties": {"type": "array", "items": {"$ref": "#/$defs/property"}}, "variants": {"type": "array", "items": {"$ref": "#/$defs/variant"}}}},
    "link": {"type": "object", "additionalProperties": false, "required": ["localId", "name", "description", "origin", "certainty", "evidenceRefs", "unknowns", "fromObjectRef", "toObjectRef", "unresolvedFrom", "unresolvedTo", "mechanism", "applicability", "cardinality"], "properties": {"localId": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "origin": {"type": "string", "enum": ["IMPLEMENTATION", "ANALYTIC_EXTENSION"]}, "certainty": {"type": "string", "enum": ["CONFIRMED", "INFERRED", "UNRESOLVED"]}, "evidenceRefs": {"type": "array", "items": {"type": "string"}}, "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}}, "fromObjectRef": {"type": "string"}, "toObjectRef": {"type": "string"}, "unresolvedFrom": {"type": "string"}, "unresolvedTo": {"type": "string"}, "mechanism": {"type": "array", "items": {"$ref": "#/$defs/mechanism"}}, "applicability": {"type": "string"}, "cardinality": {"type": "string", "enum": ["DECLARED_ONE_TO_ONE", "DECLARED_ONE_TO_MANY", "CODE_IMPLIED", "UNKNOWN"]}}},
    "operation": {"type": "object", "additionalProperties": false, "required": ["localId", "name", "description", "origin", "certainty", "evidenceRefs", "unknowns", "operationKind", "targetObjectRefs", "preconditions", "rejections", "effects"], "properties": {"localId": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "origin": {"type": "string", "enum": ["IMPLEMENTATION", "ANALYTIC_EXTENSION"]}, "certainty": {"type": "string", "enum": ["CONFIRMED", "INFERRED", "UNRESOLVED"]}, "evidenceRefs": {"type": "array", "items": {"type": "string"}}, "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}}, "operationKind": {"type": "string", "enum": ["MUTATION", "QUERY", "ANALYSIS"]}, "targetObjectRefs": {"type": "array", "items": {"type": "string"}}, "preconditions": {"type": "array", "items": {"$ref": "#/$defs/effect"}}, "rejections": {"type": "array", "items": {"$ref": "#/$defs/effect"}}, "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}}}},
    "dimension": {"type": "object", "additionalProperties": false, "required": ["localId", "name", "description", "origin", "certainty", "evidenceRefs", "unknowns", "ownerObjectRef", "sourceBinding", "role", "grain"], "properties": {"localId": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "origin": {"type": "string", "enum": ["IMPLEMENTATION", "ANALYTIC_EXTENSION"]}, "certainty": {"type": "string", "enum": ["CONFIRMED", "INFERRED", "UNRESOLVED"]}, "evidenceRefs": {"type": "array", "items": {"type": "string"}}, "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}}, "ownerObjectRef": {"type": "string"}, "sourceBinding": {"type": "string"}, "role": {"type": "array", "items": {"type": "string", "enum": ["GROUPING", "FILTERING", "DISPLAY"]}}, "grain": {"type": "string"}}},
    "measure": {"type": "object", "additionalProperties": false, "required": ["localId", "name", "description", "origin", "certainty", "evidenceRefs", "unknowns", "sourceObjectRef", "inputGrain", "expression", "aggregation", "filters", "unit", "nullPolicy"], "properties": {"localId": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "origin": {"type": "string", "enum": ["IMPLEMENTATION", "ANALYTIC_EXTENSION"]}, "certainty": {"type": "string", "enum": ["CONFIRMED", "INFERRED", "UNRESOLVED"]}, "evidenceRefs": {"type": "array", "items": {"type": "string"}}, "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}}, "sourceObjectRef": {"type": "string"}, "inputGrain": {"type": "string"}, "expression": {"type": "string"}, "aggregation": {"type": "string"}, "filters": {"type": "array", "items": {"type": "string"}}, "unit": {"type": "string"}, "nullPolicy": {"type": "string"}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["localId", "name", "description", "origin", "certainty", "evidenceRefs", "unknowns", "componentMeasureRefs", "expression", "grain", "filters", "timeWindow", "dimensionRefs", "definitionCompleteness"], "properties": {"localId": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "origin": {"type": "string", "enum": ["IMPLEMENTATION", "ANALYTIC_EXTENSION"]}, "certainty": {"type": "string", "enum": ["CONFIRMED", "INFERRED", "UNRESOLVED"]}, "evidenceRefs": {"type": "array", "items": {"type": "string"}}, "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}}, "componentMeasureRefs": {"type": "array", "items": {"type": "string"}}, "expression": {"type": "string"}, "grain": {"type": "string"}, "filters": {"type": "array", "items": {"type": "string"}}, "timeWindow": {"type": "string"}, "dimensionRefs": {"type": "array", "items": {"type": "string"}}, "definitionCompleteness": {"type": "string", "enum": ["COMPLETE_FOR_READ_SCOPE", "PARTIAL"]}}}
  }
}
