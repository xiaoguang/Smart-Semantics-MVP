<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>fixture.source</groupId>
    <artifactId>build-parent</artifactId>
    <version>1.0</version>
    <relativePath>../../build-parent/pom.xml</relativePath>
  </parent>
  <artifactId>web</artifactId>
  <dependencies>
    <dependency>
      <groupId>fixture.source</groupId>
      <artifactId>common</artifactId>
    </dependency>
    <dependency>
      <groupId>fixture.libs</groupId>
      <artifactId>http-client</artifactId>
    </dependency>
    <dependency>
      <groupId>fixture.libs</groupId>
      <artifactId>provided-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>fixture.libs</groupId>
      <artifactId>runtime-only</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>fixture.libs</groupId>
      <artifactId>test-only</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>fixture.libs</groupId>
      <artifactId>profile-api</artifactId>
      <version>${fixture.profile.version}</version>
    </dependency>
    <dependency>
      <groupId>fixture.libs</groupId>
      <artifactId>wire-api</artifactId>
      <version>1.0</version>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>customer-build-profile</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>customer-build-must-not-run</id>
                <phase>validate</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <target><touch file="${customer.build.marker}"/></target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>customer-build-no-phase-profile</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>customer-build-no-phase-must-not-run</id>
                <goals><goal>run</goal></goals>
                <configuration>
                  <target><touch file="${customer.build.noPhase.marker}"/></target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
