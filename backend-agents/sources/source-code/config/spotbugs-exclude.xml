  <!--
    This is the one deliberate mutable value: a secure, source-bound DOM is shared only by the
    run-owned MapperXmlResourceView. Its consumers treat it as read-only and clone before MyBatis
    transforms; copying it here would defeat the approved same-run reuse seam.
  -->
  <Match><Bug pattern="EI_EXPOSE_REP"/><Class name="org.sourceanalysis.app.analysis.discovery.MapperXmlResourceView$MapperXmlResource"/></Match>
