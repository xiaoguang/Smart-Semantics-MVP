{
  "schemaVersion": "repository-run-config-v2",
  "policyRegistry": "jdt-artifact-policy-set-v1.json",
  "source": {
    "repositoryPath": "/absolute/path/to/read-only/jshERP-checkout",
    "declaredRepositoryIdentity": "https://github.com/jishenghua/jshERP.git",
    "commitId": "8c30ce7861570458920175e200bb2a6442713580"
  },
  "paths": {
    "runStore": "/absolute/path/to/ignored/run-store",
    "captureWorkspace": "/absolute/path/to/ignored/capture-workspace",
    "stateFile": "/absolute/path/to/ignored/materials-state.json",
    "gitExecutable": "/usr/bin/git"
  },
  "sourceAnalysis": {
