      "providers": {
        "pro": {
          "kind": "codexSubscription",
          "quotaScope": "declared-pro-account",
          "maxConcurrentJobs": 4,
          "model": "gpt-5.6-luna",
          "reasoningEffort": "high",
          "executable": "/absolute/path/to/codex",
          "timeoutSeconds": 600,
          "auth": {
            "mode": "chatgpt",
            "codexHomeEnv": "SOURCE_ANALYSIS_PRO_HOME"
          }
        }
      },
      "routing": {
        "activity": ["pro"],
        "processGroup": ["pro"],
        "repositorySummary": ["pro"],
        "report": ["pro"]
      }
    }
  },
  "inputs": {
