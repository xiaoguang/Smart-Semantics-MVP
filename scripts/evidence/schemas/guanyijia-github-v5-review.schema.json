{
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "claims"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "claims": {
      "type": "array",
      "minItems": 40,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "section", "kind", "title", "statement", "reviewFocus", "boundary", "evidenceRefs", "focusIdentifiers"],
        "properties": {
          "claimId": { "type": "string", "pattern": "^github-v5-[0-9]{3}$" },
          "section": { "type": "integer", "minimum": 1, "maximum": 9 },
          "kind": { "type": "string", "enum": ["ARCHITECTURE", "CODE_BEHAVIOR", "CONFIGURATION", "SCHEMA_MIGRATION", "QUERY", "BUSINESS_RULE", "GAP"] },
          "title": { "type": "string", "minLength": 2, "maxLength": 28 },
          "statement": { "type": "string", "minLength": 50, "maxLength": 240 },
          "reviewFocus": { "type": "string", "minLength": 20, "maxLength": 140 },
          "boundary": { "type": "string", "minLength": 20, "maxLength": 140 },
          "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string" } },
          "focusIdentifiers": { "type": "array", "items": { "type": "string", "maxLength": 80 } }
        }
      }
    }
  }
}
