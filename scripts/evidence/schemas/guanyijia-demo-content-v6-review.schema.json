{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceId", "title", "sections"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "sections": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "title", "body", "coverageRefs"],
        "properties": {
          "section": {
            "type": "string",
            "enum": [
              "OVERVIEW",
              "GOAL",
              "OBJECT",
              "ACTIVITY",
              "FIELD",
              "RELATION",
              "METRIC",
              "QUESTION",
              "UNRESOLVED"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 4,
            "maxLength": 40
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "coverageRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
