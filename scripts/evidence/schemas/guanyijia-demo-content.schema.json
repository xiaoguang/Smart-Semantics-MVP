{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documents", "graph"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "documents": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path": { "type": "string" },
          "content": { "type": "string" }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "graphId", "terms", "relations"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "graphId": { "type": "string" },
        "terms": {
          "type": "array",
          "minItems": 48,
          "maxItems": 72,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["termId", "name", "definition", "domain", "aliases"],
            "properties": {
              "termId": { "type": "string" },
              "name": { "type": "string" },
              "definition": { "type": "string" },
              "domain": { "type": "string" },
              "aliases": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "relations": {
          "type": "array",
          "minItems": 72,
          "maxItems": 120,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relationId", "subjectId", "predicate", "objectId", "description"],
            "properties": {
              "relationId": { "type": "string" },
              "subjectId": { "type": "string" },
              "predicate": { "type": "string" },
              "objectId": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
